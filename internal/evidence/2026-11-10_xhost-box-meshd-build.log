[workspace]
members = ["crates/agent-core", "crates/adapter-codex", "crates/agent-runtime"]
resolver = "3"

[workspace.package]
edition = "2024"
license = "MIT"
rust-version = "1.95"

[workspace.dependencies]
pharos-agent-core = { path = "crates/agent-core" }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
time = { version = "0.3", features = ["formatting", "parsing"] }
uuid = { version = "1.0", features = ["v4"] }
