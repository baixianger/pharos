# Phase E: Linux artifacts are Rust-only (no Swift / MeshKit / iroh-ffi).
FROM rust:1.91-bookworm AS pharos-build

RUN apt-get update \
    && apt-get install -y --no-install-recommends clang pkg-config libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src/pharos
COPY rust/ rust/
WORKDIR /src/pharos/rust
RUN cargo build --locked --release -p pharos-cli -p pharos-agent-runtime -p pharos-web

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends libsqlite3-0 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=pharos-build /src/pharos/rust/target/release/pharos /usr/local/bin/pharos
COPY --from=pharos-build /src/pharos/rust/target/release/pharos-meshd /usr/local/bin/pharos-meshd
COPY --from=pharos-build /src/pharos/rust/target/release/pharos-web /usr/local/bin/pharos-web
# Compatibility name used by older packaging / docs.
RUN ln -sf /usr/local/bin/pharos /usr/local/bin/pharos-mesh
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/pharos"]
CMD ["--help"]
